PORT=5000
FRONTEND_URL=http://localhost:3000

# MySQL relational database (mandatory)
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=your_mysql_password
MYSQL_DATABASE=startup_funding_platform

# MongoDB stores pitch-deck text documents and activity/audit records
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DATABASE=startup_funding_nosql

# Secret for signing JWT authentication cookies
JWT_SECRET=replace_this_with_a_long_random_secret_at_least_32_chars
